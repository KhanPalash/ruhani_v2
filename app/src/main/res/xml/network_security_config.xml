<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for Ruhani.

  Every production endpoint the app talks to (Quran API, AlAdhan, Hisnul Muslim,
  Bangla Hadith, GitHub releases, Firebase) is HTTPS, so cleartext is denied by
  default. The only exceptions below are the loopback / emulator hosts used by
  the Firebase emulator suite in local development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local development only: Firebase emulator loopback addresses. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
